# v3 : l'application seule est versionnée ici. Les données (registres, missions, références DEFA, MORA, AIRAC…)
# vivent dans data/, clone du dépôt de données (privé) — voir docs/INSTALL.md.
data/

# Caches et fichiers de travail
__pycache__/
AircraftDB/aircraft_http_cache.json
AircraftDB/icao_doc8643_cache/
# bases des types d'aéronefs (OACI Doc 8643, EUROCONTROL APD) : non publiées, complétées sur chaque poste type par type
# (Paramètres › Maintenance › Références et dépendances ; LICENSE.md)
AircraftDB/aircraft_db.js
AircraftDB/aircraft_perf.js
AircraftDB/*.tmp
*.backup-*.html
Stub/
.claude/worktrees/
tools/_verify/

# Archives de release (publiées sur framagit, hors dépôt)
dist/

# Fichiers de l'ancienne arborescence (v2), à ranger dans data/ par tools/migrate_v3.py
VERSION.json
defa_local_store.yaml
flight_performance_database_merged.fpdb.json
tools/.assets_seen.json
tools/.defa_site.json

# Commit courant pour le pied de page (tools/write_build.sh, crochets git)
config/build.js

# Repère de l’installation lancée (tools/launch.py) : contrôle du dossier autorisé
.defa_instance

# secrets locaux (clé d’API IVAO… : secrets/ivao.json), jamais versionnés
secrets/

# Site statique construit par tools/build_pages.py (appli iOS : mobile/, .github/workflows/ios.yml)
_site/
