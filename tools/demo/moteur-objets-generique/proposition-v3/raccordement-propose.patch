+    @route('GET', '/__setup/mission-objects/status', '/__setup/mission-objects/events', public='poste')
+    def _get_mission_objects(self, path):
+        if not self._allowed() or self._lan() or self._relay():
+            return self._json({'error': 'refused'}, 403)
+        state = mission_objects.RUNTIME.status()
+        if path.endswith('/events'):
+            try:
+                after = int((urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query).get('after') or ['0'])[0])
+            except ValueError:
+                return self._json({'error': 'cursor'}, 400)
+            with mission_objects.RUNTIME.lock:
+                state['events'] = [e for e in mission_objects.RUNTIME.events if e['cursor'] > after] if state['active'] else []
+        return self._json(state)
+
+    @route('GET', '/__setup/mission-objects/agent', public='poste')
+    def _get_mission_objects_agent(self, path):
+        if not self._allowed() or self._lan() or self._relay():
+            return self._json({'error': 'refused'}, 403)
+        body = mission_objects.RUNTIME.snapshot().encode('utf-8')
+        self.send_response(200)
+        self.send_header('Content-Type', 'text/plain; charset=utf-8')
+        self.send_header('Content-Length', str(len(body)))
+        self.send_header('Cache-Control', 'no-store')
+        self.send_header('Connection', 'close')
+        self.end_headers()
+        self.wfile.write(body)
+        self.close_connection = True
+        return None
+
+    @route('POST', '/__setup/mission-objects/session', '/__setup/mission-objects/report', public='poste')
+    def _post_mission_objects(self, path, body):
+        if not self._allowed() or self._lan() or self._relay():
+            return self._json({'error': 'refused'}, 403)
+        value, why = safe_json.loads(body)
+        if why:
+            return self._json({'error': 'json'}, 400)
+        try:
+            mission_objects.RUNTIME.configure(DATA)
+            result = mission_objects.RUNTIME.report(value) if path.endswith('/report') else mission_objects.RUNTIME.publish(value)
+            return self._json(result)
+        except (ValueError, TypeError, KeyError, OverflowError):
+            return self._json({'error': 'invalid_object_session'}, 400)
